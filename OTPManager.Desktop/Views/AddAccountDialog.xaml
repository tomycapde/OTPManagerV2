<Window x:Class="OTPManager.Desktop.Views.AddAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Cuenta OTP"
        Height="480" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9F9FB"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SuggestionChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F4F9"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#D0E2F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- QR & URI Import Options Banner -->
        <Border Grid.Row="0" Background="#EEF4FC" BorderBrush="#C7DDF7" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="⚡ Importar Código QR:" FontWeight="SemiBold" FontSize="11" Foreground="#005A9E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🖥️ Pantalla" Style="{StaticResource SuggestionChipStyle}" Padding="7,3" ToolTip="Recortar y escanear un código QR visible en tu pantalla" Click="ScanScreen_Click"/>
                        <Button Content="📷 Cámara" Style="{StaticResource SuggestionChipStyle}" Padding="7,3" ToolTip="Escanear un código QR con tu cámara web" Click="ScanCamera_Click"/>
                        <Button Content="📋 Portapapeles" Style="{StaticResource SuggestionChipStyle}" Padding="7,3" ToolTip="Leer código QR desde una imagen copiada al portapapeles" Click="ScanClipboard_Click"/>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="UriInput" Height="26" FontSize="11" Padding="4,2" TextChanged="UriInput_TextChanged" ToolTip="Pega aquí un enlace otpauth://totp/... o se autocompletará con el escáner QR"/>
            </StackPanel>
        </Border>

        <!-- Account / User Name -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Nombre de cuenta / Título:" FontSize="12" Foreground="#444444" Margin="0,0,0,4"/>
            <TextBox x:Name="LabelInput" Height="30" FontSize="13" Padding="6,4"/>
        </StackPanel>

        <!-- TAGS section -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Etiquetas / Tags:" FontSize="12" Foreground="#444444" Margin="0,0,0,4"/>
            <TextBox x:Name="TagsInput" Height="30" FontSize="13" Padding="6,4"/>
        </StackPanel>

        <!-- Secret Key -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Clave secreta (Base32):" FontSize="12" Foreground="#444444" VerticalAlignment="Center"/>
                <Button x:Name="UnlockSecretBtn" Grid.Column="1" Content="🔒 Modificar semilla" Style="{StaticResource SuggestionChipStyle}" Padding="7,2" Margin="0" Visibility="Collapsed" Click="UnlockSecret_Click"/>
            </Grid>
            <TextBox x:Name="SecretInput" Height="30" FontSize="13" Padding="6,4" CharacterCasing="Upper"/>
        </StackPanel>

        <!-- Digits and Algorithm -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Dígitos:" FontSize="12" Foreground="#444444" Margin="0,0,0,4"/>
                <ComboBox x:Name="DigitsSelect" Height="30" SelectedIndex="0">
                    <ComboBoxItem Content="6 Dígitos"/>
                    <ComboBoxItem Content="8 Dígitos"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Algoritmo:" FontSize="12" Foreground="#444444" Margin="0,0,0,4"/>
                <ComboBox x:Name="AlgorithmSelect" Height="30" SelectedIndex="0">
                    <ComboBoxItem Content="SHA1"/>
                    <ComboBoxItem Content="SHA256"/>
                    <ComboBoxItem Content="SHA512"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorMessage" Grid.Row="5" Foreground="#D13438" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" Width="85" Height="32" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Guardar" IsDefault="True" Width="85" Height="32" Background="#0067C0" Foreground="White" BorderThickness="0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
