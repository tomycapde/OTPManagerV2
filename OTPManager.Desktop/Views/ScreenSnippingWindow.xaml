<Window x:Class="OTPManager.Desktop.Views.ScreenSnippingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">

    <Grid>
        <!-- Frozen screen snapshot in background -->
        <Image x:Name="BackgroundImage" Stretch="Fill"/>

        <!-- Semi-transparent overlay to dim the screen -->
        <Border Background="#66000000"/>

        <Canvas x:Name="SelectionCanvas">
            <!-- Rubber-band selection rectangle -->
            <Border x:Name="CutoutBox" 
                    BorderBrush="#0078D4" 
                    BorderThickness="2" 
                    CornerRadius="3"
                    Background="#1A0078D4"
                    Visibility="Collapsed"/>
        </Canvas>

        <!-- Top Instruction Banner -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Background="#EE1E242E"
                CornerRadius="8"
                Padding="16,8"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 Arrastra un recuadro sobre el código QR en tu pantalla" 
                           Foreground="White" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  •  " Foreground="#888888" VerticalAlignment="Center"/>
                <TextBlock Text="Presiona ESC para cancelar" 
                           Foreground="#AAAAAA" 
                           FontSize="12" 
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
