<Window x:Class="OTPManager.Desktop.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contraseña de Respaldo"
        Height="210" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9F9FB"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Text="Introduce la contraseña para continuar:" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13" Foreground="#333333"/>
        <PasswordBox x:Name="PasswordInput" Grid.Row="1" Height="32" FontSize="14" Padding="6,4" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" Width="85" Height="30" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Aceptar" IsDefault="True" Width="85" Height="30" Background="#0067C0" Foreground="White" BorderThickness="0" Click="Accept_Click"/>
        </StackPanel>
    </Grid>
</Window>
