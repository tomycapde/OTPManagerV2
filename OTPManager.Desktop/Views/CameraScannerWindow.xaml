<Window x:Class="OTPManager.Desktop.Views.CameraScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escanear Código QR con Cámara"
        Height="500" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#181B22"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Camera Selector -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="📷 Apunta el código QR hacia la cámara" 
                           Foreground="White" 
                           FontSize="14" 
                           FontWeight="SemiBold"/>
                <TextBlock Text="El código se detectará y cargará automáticamente." 
                           Foreground="#8C93A0" 
                           FontSize="11" 
                           Margin="0,2,0,0"/>
            </StackPanel>

            <ComboBox x:Name="CameraSelector" 
                      Grid.Column="1" 
                      Width="150" 
                      Height="28" 
                      VerticalAlignment="Center"
                      SelectionChanged="CameraSelector_SelectionChanged"
                      Visibility="Collapsed"/>
        </Grid>

        <!-- Video Preview Container with Viewfinder -->
        <Border Grid.Row="1" 
                Background="#0F1116" 
                BorderBrush="#2D333F" 
                BorderThickness="1" 
                CornerRadius="8" 
                ClipToBounds="True">
            <Grid>
                <!-- Live Video Feed -->
                <Image x:Name="CameraPreview" Stretch="Uniform"/>

                <!-- Viewfinder Targeting Guide -->
                <Border Width="200" Height="200" 
                        BorderBrush="#0078D4" 
                        BorderThickness="2" 
                        CornerRadius="12" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Background="#0D0078D4">
                    <Grid>
                        <!-- Center crosshair or pulse cue -->
                        <TextBlock Text="[ QR ]" 
                                   Foreground="#50A0E0" 
                                   FontSize="13" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" 
                                   Opacity="0.7"/>
                    </Grid>
                </Border>

                <!-- No Camera Message Overlay -->
                <StackPanel x:Name="NoCameraOverlay" 
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Visibility="Collapsed">
                    <TextBlock Text="⚠️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="NoCameraMessage" 
                               Text="No se detectó ninguna cámara web disponible." 
                               Foreground="#D13438" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Notification -->
        <Border Grid.Row="2" Margin="0,12,0,12" Background="#242833" CornerRadius="6" Padding="10,6">
            <TextBlock x:Name="StatusText" 
                       Text="Iniciando cámara web..." 
                       Foreground="#A0A8B8" 
                       FontSize="12" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" 
                    Width="90" 
                    Height="30" 
                    Background="#2A2F3D" 
                    Foreground="White" 
                    BorderThickness="1"
                    BorderBrush="#3E4557"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
