<Window x:Class="OTPManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OTPManager.Desktop"
        mc:Ignorable="d"
        Title="OTP Manager v1.1" 
        Icon="Assets/icon.png"
        Height="680" Width="500"
        MinWidth="440" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TagFilterChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF4FC"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#CCE3F8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D0D4DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CopyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF4FC"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#C7DDF7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Menus -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E4E8" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OTP Manager" FontSize="18" FontWeight="Bold" Foreground="#1F242E" VerticalAlignment="Center"/>
                    <Border Background="#E8F1FB" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.1" FontSize="10" FontWeight="Bold" Foreground="#005A9E"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Backup Menu Button -->
                    <Button x:Name="BackupMenuBtn" Content="📁 Copia de seguridad ▾" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BackupMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📥 Importar (.otpm)..." Click="ImportBackup_Click"/>
                                <MenuItem Header="📤 Exportar (.otpm)..." Click="ExportBackup_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Add Account Dropdown Button -->
                    <Button x:Name="AddAccountMenuBtn" Content="+ Agregar Cuenta ▾" Style="{StaticResource PrimaryButtonStyle}" Click="AddAccountMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="✏️ Entrada manual..." Click="AddAccountManual_Click"/>
                                <Separator/>
                                <MenuItem Header="🖥️ Capturar de pantalla (QR)" Click="MainScanScreen_Click"/>
                                <MenuItem Header="📷 Escanear con cámara web" Click="MainScanCamera_Click"/>
                                <MenuItem Header="📋 Pegar del portapapeles" Click="MainScanClipboard_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Always-Visible Search Bar & Tags Bar -->
        <StackPanel Grid.Row="1" Margin="16,10,16,6">
            <Border Background="White" BorderBrush="#CCD1DB" BorderThickness="1" CornerRadius="8" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="#777777" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="13" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Buscar por cuenta o etiqueta (#tag)..." Foreground="#8C93A0" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Button x:Name="ClearSearchBtn" Grid.Column="2" Content="✕" Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#888888" Cursor="Hand" Visibility="Collapsed" Click="ClearSearch_Click"/>
                </Grid>
            </Border>

            <!-- Quick Tag Filter Chips -->
            <ScrollViewer x:Name="TagFilterScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0" Visibility="Collapsed">
                <StackPanel x:Name="TagFilterPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </StackPanel>

        <!-- Countdown Progress Bar -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <ProgressBar x:Name="TotpProgressBar" Height="4" Minimum="0" Maximum="30" Value="30" Foreground="#0078D4" Background="#E2E4E8" BorderThickness="0"/>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="3" Margin="16,0,16,16">
            <!-- Account List -->
            <ScrollViewer x:Name="AccountsScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AccountsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AccountCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AccountName}" FontWeight="Bold" FontSize="15" Foreground="#005A9E" TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                                        
                                        <!-- Tags Chips -->
                                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,1,0,6" Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#EEF4FC" BorderBrush="#CCE3F8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                        <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="#005A9E"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding FormattedOTP}" FontFamily="Consolas, Segoe UI" FontSize="28" FontWeight="Bold" Foreground="#1F242E"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button Content="Copiar" Style="{StaticResource CopyButtonStyle}" Tag="{Binding}" Click="CopyCode_Click" Margin="0,0,6,0" ToolTip="Copiar código al portapapeles"/>
                                        
                                        <Button Content="⋮" Width="30" Height="30" FontSize="16" Background="Transparent" BorderThickness="0" Foreground="#666666" Cursor="Hand" Click="ItemMenu_Click" Tag="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="✏️ Editar" Click="EditAccount_Click"/>
                                                    <MenuItem Header="🗑️ Eliminar" Click="DeleteAccount_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty State 1: No accounts saved -->
            <StackPanel x:Name="EmptyVaultBanner" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="🔑" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="No tienes cuentas guardadas" FontSize="16" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Agrega tu primera cuenta o importa una copia de seguridad." FontSize="13" Foreground="#777777" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="+ Agregar Cuenta ▾" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="AddAccountMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="✏️ Entrada manual..." Click="AddAccountManual_Click"/>
                                <Separator/>
                                <MenuItem Header="🖥️ Capturar de pantalla (QR)" Click="MainScanScreen_Click"/>
                                <MenuItem Header="📷 Escanear con cámara web" Click="MainScanCamera_Click"/>
                                <MenuItem Header="📋 Pegar del portapapeles" Click="MainScanClipboard_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="📥 Importar .otpm" Style="{StaticResource SecondaryButtonStyle}" Click="ImportBackup_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Empty State 2: No search results -->
            <StackPanel x:Name="NoSearchResultsBanner" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="🔍" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="NoSearchResultsText" Text="No se encontraron cuentas" FontSize="16" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Intenta con otro término de búsqueda." FontSize="13" Foreground="#777777" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <Button Content="Borrar búsqueda" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" Click="ClearSearch_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
