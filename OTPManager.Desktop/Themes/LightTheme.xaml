<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window & Layout -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#F9F9FB"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#E2E4E8"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E4E8"/>
    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#EEF4FC"/>
    <SolidColorBrush x:Key="BannerBorderBrush" Color="#C7DDF7"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F242E"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#333333"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#777777"/>
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#8C93A0"/>
    <SolidColorBrush x:Key="CardTitleForegroundBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="CardOtpForegroundBrush" Color="#1F242E"/>
    <SolidColorBrush x:Key="IconButtonForegroundBrush" Color="#666666"/>
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#D13438"/>

    <!-- Badges & Chips -->
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#EEF4FC"/>
    <SolidColorBrush x:Key="ChipForegroundBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#CCE3F8"/>
    <SolidColorBrush x:Key="ChipActiveBackgroundBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="ChipActiveForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ChipActiveBorderBrush" Color="#005A9E"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF"/>
    
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#D0D4DC"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="#F5F6F8"/>

    <SolidColorBrush x:Key="CopyButtonBackgroundBrush" Color="#EEF4FC"/>
    <SolidColorBrush x:Key="CopyButtonForegroundBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="CopyButtonBorderBrush" Color="#C7DDF7"/>

    <!-- Inputs & Search -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#1F242E"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CCD1DB"/>
    <SolidColorBrush x:Key="InputDisabledBackgroundBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="InputDisabledForegroundBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="SearchBoxBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SearchBoxBorderBrush" Color="#CCD1DB"/>
    <SolidColorBrush x:Key="SearchBoxForegroundBrush" Color="#1F242E"/>

    <!-- Progress Bar -->
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="#E2E4E8"/>
    <SolidColorBrush x:Key="ProgressBarFillBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="ProgressBarWarningBrush" Color="#FF8C00"/>

    <!-- Context Menu & Popup -->
    <SolidColorBrush x:Key="ContextMenuBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ContextMenuForegroundBrush" Color="#1F242E"/>
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#E2E4E8"/>
    <SolidColorBrush x:Key="MenuItemHoverBackgroundBrush" Color="#F0F4F9"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E2E4E8"/>

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C0C4CC"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A0A4AC"/>

</ResourceDictionary>
